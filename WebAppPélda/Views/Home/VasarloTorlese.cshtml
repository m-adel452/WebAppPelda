@model WebAppPelda.Models.Vasarlo;

@{
    ViewData["Title"] = "Vásárló törlése";
}

<div class="container mt-4" style="max-width:600px">
    <h2 class="mb-4">Vásárló adatai</h2>
    @if(TempData["SuccessMessage"]!=null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <form asp-controller="Home" asp-action="VasarloTorlese" method="post" class="needs-validation" novalidate>

        <div class="mb-3">
            <label asp-for="Id" class="form-label"></label>
            <input asp-for="Id" type="number" class="form-control" disabled/>
        </div>
        <div class="mb-3">
            <label asp-for="Nev" class="form-label"></label>
            <input asp-for="Nev" class="form-control" placeholder="Minta János">
        </div>
        <div class="mb-3">
            <label asp-for="Cim" class="form-label"></label>
            <input asp-for="Cim" class="form-control" placeholder="1051 Budapest, Fő tér 1.">
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" placeholder="mintajanos@example.com">
        </div>
        <div class="mb-3">
            <label asp-for="Telefon" class="form-label"></label>
            <input asp-for="Telefon" class="form-control" placeholder="+36 1 123 4567">
        </div>
        <div class="mb-3">
            <label asp-for="Pontszam" class="form-label"></label>
            <input asp-for="Pontszam" type="number" class="form-control">
        </div>
        <button type="submit" class="btn btn-primary w-100">Vásárló végleges törlése</button>
    </form>
</div>
